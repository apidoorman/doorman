# ============================================================================
# DEMO ENVIRONMENT CONFIGURATION
# ============================================================================
# Ready-to-use settings for the Docker demo. Copy to .env and launch:
#
#   cp .env.demo .env
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up --build
#
# Web UI:  http://localhost:3000
# API:     http://localhost:3001
# Admin:   demo@doorman.dev / DemoPassword123!
# ============================================================================

ENV=development

DOORMAN_ADMIN_EMAIL=demo@doorman.dev
DOORMAN_ADMIN_PASSWORD=DemoPassword123!

# ============================================================================
# DATABASE & CACHE CONFIGURATION
# ============================================================================
MEM_OR_EXTERNAL=MEM
MEM_DUMP_PATH=generated/memory_dump.bin

# ============================================================================
# SECRETS (demo-only — do NOT use in production)
# ============================================================================
JWT_SECRET_KEY=demo-secret-change-me-please-32-bytes-min
TOKEN_ENCRYPTION_KEY=
MEM_ENCRYPTION_KEY=

# Access/refresh token expiry
AUTH_EXPIRE_TIME=30
AUTH_EXPIRE_TIME_FREQ=minutes
AUTH_REFRESH_EXPIRE_TIME=7
AUTH_REFRESH_EXPIRE_FREQ=days

# ============================================================================
# HTTPS / COOKIES
# ============================================================================
# Demo runs on plain HTTP — no TLS termination needed locally.
HTTPS_ONLY=false
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=Lax

# ============================================================================
# HTTP CLIENT
# ============================================================================
ENABLE_HTTPX_CLIENT_CACHE=true
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=50
HTTP_KEEPALIVE_EXPIRY=30.0
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=30.0
HTTP_WRITE_TIMEOUT=30.0
HTTP_TIMEOUT=30.0
HTTP_ENABLE_HTTP2=false

# ============================================================================
# SECURITY
# ============================================================================
MAX_BODY_SIZE_BYTES=1048576
LOCAL_HOST_IP_BYPASS=true
LOGIN_IP_RATE_LIMIT=1000000
LOGIN_IP_RATE_WINDOW=60

# ============================================================================
# COMPRESSION & CACHE
# ============================================================================
COMPRESSION_ENABLED=true
COMPRESSION_MINIMUM_SIZE=500
COMPRESSION_LEVEL=1
CACHE_MAX_SIZE=10000

# ============================================================================
# LOGGING
# ============================================================================
LOG_FORMAT=plain

# ============================================================================
# APP PORTS
# ============================================================================
PORT=3001
PYTHON_INTERNAL_PORT=3002
PYTHON_INTERNAL_URL=http://127.0.0.1:3002
GATEWAY_RUST_ENABLED=false
GATEWAY_RUST_MODE=off
GATEWAY_POLICY_CACHE_TTL_SECONDS=1
WEB_PORT=3000
THREADS=1
DEV_RELOAD=false
PID_FILE=doorman.pid

# ============================================================================
# FRONTEND
# ============================================================================
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
DOORMAN_ENABLE_GQL_CLIENT=True
